---
import { site } from '../config';
---

<section class="section anfrage" id="anfrage">
  <div class="wrap anfrage__grid">
    <div class="anfrage__intro">
      <span class="eyebrow">Anfrage</span>
      <h2>Erzähl mir von deinem Spiel.</h2>
      <p class="lead">
        Je mehr ich weiß, desto genauer wird das Angebot. Du bekommst eine Antwort per E-Mail –
        unverbindlich.
      </p>
      <ul class="anfrage__direkt">
        <li>
          <span>E-Mail</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <span>Instagram</span>
          <a href={site.instagram.url} rel="noopener">{site.instagram.handle}</a>
        </li>
      </ul>
    </div>

    <form
      class="formular"
      id="anfrage-form"
      data-key={site.formAccessKey}
      data-email={site.email}
      novalidate
    >
      <div class="formular__reihe">
        <label>
          <span>Name</span>
          <input name="name" autocomplete="name" required />
        </label>
        <label>
          <span>E-Mail</span>
          <input name="email" type="email" autocomplete="email" required />
        </label>
      </div>

      <fieldset class="formular__art">
        <legend>Worum geht es?</legend>
        <label><input type="radio" name="art" value="Brettspiel-Insert" checked /> Brettspiel-Insert</label>
        <label><input type="radio" name="art" value="3D-Druck nach Auftrag" /> 3D-Druck</label>
        <label><input type="radio" name="art" value="Modelldesign" /> Modelldesign</label>
      </fieldset>

      <div class="formular__reihe" data-nur-insert>
        <label>
          <span>Spiel &amp; Erweiterungen</span>
          <input name="spiel" placeholder="z. B. Calico + Kickstarter-Extras" />
        </label>
        <label>
          <span>Karten in Hüllen (Sleeves)?</span>
          <select name="sleeves">
            <option>Weiß ich nicht</option>
            <option>Ja</option>
            <option>Nein</option>
            <option>Keine Karten im Spiel</option>
          </select>
        </label>
      </div>

      <label>
        <span>Deine Nachricht</span>
        <textarea name="nachricht" rows="5" required placeholder="Was soll in die Schachtel, Wunschfarbe, Besonderheiten …"
        ></textarea>
      </label>

      <label class="formular__check">
        <input type="checkbox" name="datenschutz" required />
        <span>
          Ich bin einverstanden, dass meine Angaben zur Bearbeitung der Anfrage verwendet werden.
          Mehr in der <a href="/datenschutz/">Datenschutzerklärung</a>.
        </span>
      </label>

      <!-- Honeypot gegen Spam-Bots -->
      <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />

      <button class="btn btn--primary" type="submit">Anfrage senden</button>
      <p class="formular__status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#anfrage-form');
  if (form) {
    const status = form.querySelector<HTMLElement>('.formular__status')!;
    const insertFelder = form.querySelector<HTMLElement>('[data-nur-insert]')!;

    form.addEventListener('change', () => {
      const art = (form.elements.namedItem('art') as RadioNodeList).value;
      insertFelder.hidden = art !== 'Brettspiel-Insert';
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const daten = new FormData(form);
      if (daten.get('botcheck')) return;
      const art = String(daten.get('art'));
      const zeilen = [
        `Art: ${art}`,
        ...(art === 'Brettspiel-Insert'
          ? [`Spiel: ${daten.get('spiel') || '–'}`, `Sleeves: ${daten.get('sleeves')}`]
          : []),
        '',
        String(daten.get('nachricht')),
        '',
        `${daten.get('name')} <${daten.get('email')}>`,
      ];
      const betreff = `Anfrage: ${art}${daten.get('spiel') && art === 'Brettspiel-Insert' ? ` – ${daten.get('spiel')}` : ''}`;

      const key = form.dataset.key;
      if (!key) {
        // Ohne Formulardienst: E-Mail-Programm mit fertiger Nachricht öffnen.
        window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(betreff)}&body=${encodeURIComponent(zeilen.join('\n'))}`;
        status.textContent = 'Dein E-Mail-Programm öffnet sich mit der fertigen Nachricht – nur noch absenden.';
        return;
      }

      const button = form.querySelector('button')!;
      button.disabled = true;
      status.textContent = 'Wird gesendet …';
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: key,
            subject: betreff,
            from_name: 'Website Additive Manufaktur',
            name: daten.get('name'),
            email: daten.get('email'),
            message: zeilen.join('\n'),
          }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        insertFelder.hidden = false;
        status.textContent = 'Danke! Deine Anfrage ist angekommen – ich melde mich per E-Mail.';
      } catch {
        status.textContent = `Das hat leider nicht geklappt. Schreib mir gern direkt an ${form.dataset.email}.`;
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .anfrage {
    background: var(--accent-soft);
  }

  .anfrage__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.2fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
  }

  .anfrage__direkt {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    gap: 14px;
  }

  .anfrage__direkt span {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .anfrage__direkt a {
    font-weight: 600;
    font-size: 1.1rem;
    overflow-wrap: anywhere;
  }

  .formular {
    display: grid;
    gap: 18px;
    background: var(--surface);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 4vw, 40px);
    box-shadow: var(--shadow);
  }

  .formular__reihe {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .formular__reihe[hidden] {
    display: none;
  }

  .formular label > span,
  .formular legend {
    display: block;
    font-weight: 600;
    font-size: 0.92rem;
    margin-bottom: 6px;
  }

  .formular input:not([type='radio'], [type='checkbox']),
  .formular select,
  .formular textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: var(--bg);
    border: 1.5px solid var(--line);
    border-radius: 10px;
    padding: 11px 14px;
  }

  .formular input:focus,
  .formular select:focus,
  .formular textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .formular textarea {
    resize: vertical;
  }

  .formular__art {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .formular__art legend {
    width: 100%;
  }

  .formular__art label {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
    font-size: 0.95rem;
  }

  .formular__art label:has(input:checked) {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .formular__art input {
    accent-color: var(--accent);
  }

  .formular__check {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .formular__check input {
    margin-top: 4px;
    accent-color: var(--accent);
    flex: none;
  }

  .formular .btn {
    justify-self: start;
  }

  .formular .btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .formular__status {
    margin: 0;
    font-weight: 500;
  }

  .formular__status:empty {
    display: none;
  }

  @media (max-width: 860px) {
    .anfrage__grid,
    .formular__reihe {
      grid-template-columns: 1fr;
    }
  }
</style>
