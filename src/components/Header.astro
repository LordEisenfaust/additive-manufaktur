---
import { nav, site } from '../config';
import Logo from './Logo.astro';
---

<header class="header">
  <div class="wrap header__inner">
    <a class="header__brand" href="/" aria-label={`${site.name} – Startseite`}>
      <Logo />
      <span>{site.name}</span>
    </a>

    <nav class="header__nav" aria-label="Hauptnavigation">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="btn btn--primary header__cta" href="/#anfrage">Anfragen</a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(251 246 238 / 88%);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 68px;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .header__nav {
    margin-left: auto;
  }

  .header__nav ul {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__nav a {
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.97rem;
  }

  .header__nav a:hover {
    color: var(--ink);
  }

  .header__cta {
    padding: 0.55em 1.2em;
    font-size: 0.95rem;
  }

  @media (max-width: 820px) {
    .header__nav {
      display: none;
    }

    .header__cta {
      margin-left: auto;
    }
  }

  @media (max-width: 380px) {
    .header__brand span {
      font-size: 1rem;
    }
  }
</style>
