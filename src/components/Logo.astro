---
// Bildmarke: vier Fächer eines Inserts, eines davon „noch leer“.
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <rect width="64" height="64" rx="14" fill="var(--accent)"></rect>
  <g fill="var(--bg)">
    <rect x="12" y="12" width="17" height="17" rx="3"></rect>
    <rect x="35" y="12" width="17" height="17" rx="3"></rect>
    <rect x="12" y="35" width="17" height="17" rx="3"></rect>
    <rect x="35" y="35" width="17" height="17" rx="3" opacity=".55"></rect>
  </g>
</svg>
