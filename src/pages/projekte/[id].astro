---
import { Picture } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projekte = await getCollection('projekte');
  return projekte.map((projekt) => ({ params: { id: projekt.id }, props: { projekt } }));
}

interface Props {
  projekt: CollectionEntry<'projekte'>;
}

const { projekt } = Astro.props;
const { titel, spiel, kurz, bild, bildAlt, galerie, fakten } = projekt.data;
const { Content } = await render(projekt);
---

<Layout title={titel} description={`${titel}: ${kurz}`}>
  <article class="section projekt">
    <div class="wrap">
      <a class="zurueck" href="/projekte/">← Alle Projekte</a>

      <header class="projekt__kopf">
        <span class="eyebrow">{spiel}</span>
        <h1>{titel}</h1>
        <p class="lead">{kurz}</p>
      </header>

      <Picture
        src={bild}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200, 1400]}
        sizes="(max-width: 1160px) 100vw, 1080px"
        alt={bildAlt}
        class="projekt__bild"
        loading="eager"
      />

      <div class="projekt__inhalt">
        <div class="prose">
          <Content />
        </div>

        {fakten.length > 0 && (
          <dl class="fakten">
            {fakten.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.wert}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>

      {galerie.length > 0 && (
        <div class="galerie">
          {galerie.map((g) => (
            <Picture
              src={g.bild}
              formats={['avif', 'webp']}
              widths={[400, 700, 1000]}
              sizes="(max-width: 700px) 100vw, 520px"
              alt={g.alt}
            />
          ))}
        </div>
      )}

      <aside class="cta">
        <div>
          <h2>Auch so etwas für dein Spiel?</h2>
          <p>Schreib mir, welches Spiel du sortieren möchtest – ich mache dir ein Angebot.</p>
        </div>
        <a class="btn btn--primary" href="/#anfrage">Insert anfragen</a>
      </aside>
    </div>
  </article>
</Layout>

<style>
  .zurueck {
    display: inline-block;
    margin-bottom: 28px;
    font-weight: 600;
    text-decoration: none;
  }

  .projekt__kopf {
    max-width: 44rem;
    margin-bottom: 36px;
  }

  .projekt :global(.projekt__bild) {
    width: 100%;
    max-height: 640px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  .projekt__inhalt {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 48px;
    margin-top: 48px;
  }

  .fakten {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 8px 24px;
    align-self: start;
  }

  .fakten div {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .fakten div:last-child {
    border-bottom: 0;
  }

  .fakten dt {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .fakten dd {
    margin: 2px 0 0;
    font-weight: 500;
  }

  .galerie {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 20px;
    margin-top: 48px;
  }

  .galerie :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .cta {
    margin-top: 72px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    background: var(--accent-soft);
    border-radius: var(--radius-lg);
    padding: clamp(24px, 4vw, 44px);
  }

  .cta h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .cta p {
    margin: 0;
    color: var(--ink-soft);
  }

  @media (max-width: 860px) {
    .projekt__inhalt {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
