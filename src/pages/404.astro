---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Seite nicht gefunden" noindex>
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1>Dieses Fach ist leer.</h1>
      <p class="lead">Die Seite gibt es nicht (mehr). Vielleicht findest du auf der Startseite, was du suchst.</p>
      <a class="btn btn--primary" href="/">Zur Startseite</a>
    </div>
  </section>
</Layout>
